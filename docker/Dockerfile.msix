# makemsix from Microsoft's msix-packaging, to pack the Store's MSIX on Linux or
# macOS (MakeAppx is Windows-only). Used by build-msix.sh.
FROM ubuntu:24.04 AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential clang git ca-certificates zlib1g-dev libicu-dev python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
# msix-packaging wants CMake 3.29; Ubuntu 24.04 has 3.28. (Newer distros' ICU needs
# C++17, which its bundled Xerces doesn't build with.)
RUN pip3 install --break-system-packages cmake==3.31.6
ARG MSIX_COMMIT=25a65f5c1690930813bcc10cdf1d59fa865f2bb1
RUN git clone https://github.com/microsoft/msix-packaging.git /msix \
    && cd /msix && git checkout "${MSIX_COMMIT}" \
    && ./makelinux.sh --pack -b MinSizeRel
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libicu74 zlib1g osslsigncode openssl imagemagick \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /msix/.vs/bin/makemsix /usr/local/bin/
COPY --from=build /msix/.vs/lib/libmsix.so /usr/local/lib/
RUN ldconfig
WORKDIR /src
